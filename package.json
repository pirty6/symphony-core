{
  "name": "@perezgarciam/symphony-core",
  "version": "0.2.0",
  "packageManager": "pnpm@10.33.0",
  "description": "Deterministic, auditable AI orchestration: a pure state machine owns order, gates and validation; AI runs only inside nodes. Includes a visual studio to watch data flow live.",
  "keywords": [
    "ai",
    "orchestration",
    "agents",
    "state-machine",
    "workflow",
    "patterns"
  ],
  "homepage": "https://github.com/pirty6/symphony-core#readme",
  "bugs": {
    "url": "https://github.com/pirty6/symphony-core/issues"
  },
  "license": "ISC",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pirty6/symphony-core.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "npm run dev --prefix packages/ui --",
    "studio": "npm run dev --prefix packages/ui --",
    "cli": "tsx src/cli.ts",
    "mcp": "tsx src/mcp-server.ts",
    "mcp:http": "tsx src/mcp-server.ts --http",
    "install:vscode": "tsx src/install-vscode.ts",
    "login": "tsx src/login.ts",
    "postinstall": "node scripts/install-ui.mjs",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "npm test --prefix packages/ui",
    "test:all": "npm test && npm run test:ui",
    "prepublishOnly": "npm run build",
    "lint": "oxlint src/ packages/ui/src packages/ui/server",
    "lint:fix": "oxlint --fix src/ packages/ui/src packages/ui/server",
    "format": "oxfmt src/",
    "format:check": "oxfmt --check src/",
    "docs": "tsx src/flows.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "tsx": "^4.23.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@github/copilot": "1.0.69",
    "@github/copilot-sdk": "1.0.6",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "dotenv": "^17.4.2",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "bin": {
    "symphony": "dist/cli.js"
  }
}
