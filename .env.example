# All optional. Without them the studio and CLI still run with the offline scripted provider.

# Copilot auth: run `npm run login` once (or be signed in to gh / the Copilot CLI) and leave this unset.
# Without a browser, set a fine-grained personal access token with the "Copilot Requests" permission
# (classic ghp_ tokens are not accepted). A rejected token falls back to the signed-in user.
# COPILOT_GITHUB_TOKEN=github_pat_...

# Model for agent nodes (Copilot model id). Leave unset for the default.
# COPILOT_MODEL=claude-sonnet-4.5

# Folder agents work in (default: this repository).
# SYMPHONY_WORKSPACE=/path/to/your/project

# Delay between streamed chunks for the scripted provider in the studio (ms).
# SYMPHONY_DEMO_DELAY_MS=25
